{
    "name": "oatmael/wasm-php",
    "description": "A WASM runtime for PHP",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Oatmael\\WasmPhp\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Jaron Harrison",
            "email": "jaronharrison1605@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5",
        "brick/math": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "spec": [
            "Composer\\Config::disableProcessTimeout",
            "php tests/Spec/run.php"
        ],
        "spec:fetch": "tests/Spec/fetch-testsuite.sh"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
